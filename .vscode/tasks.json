{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Configure",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S", ".",
        "-B", "build",
        "-G", "Ninja",
        "-DCMAKE_BUILD_TYPE=Debug"
      ]
    },
    {
      "label": "CMake: Build",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build", "build"
      ],
      "dependsOn": "CMake: Configure"
    },
    {
      "label": "Run",
      "type": "shell",
      "command": "./build/Sandbox/Sandbox",
      "dependsOn": "CMake: Build"
    },
    {
      "label": "CMake: Clean",
      "type": "shell",
      "command": "cmake",
      "args": [
          "--build", "build",
          "--target", "clean"
      ]
    }
  ]
}
