{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: Configure",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S", ".",
        "-B", "build",
        "-G", "Ninja",
        "-DCMAKE_BUILD_TYPE=Debug"
      ]
    },
    {
      "label": "CMake: Build",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build", "build"
      ],
      "options": {
        "env": {
          "LD_LIBRARY_PATH": "/run/opengl-driver/lib:/run/current-system/sw/share/nix-ld/lib",
          "LIBGL_DRIVERS_PATH": "/run/opengl-driver/lib/dri"
        }
      },
      "dependsOn": "CMake: Configure"
    },
    {
      "label": "Run",
      "type": "shell",
      "command": "./build/Sandbox/Sandbox",
      "dependsOn": "CMake: Build"
    },
    {
      "label": "CMake: Clean",
      "type": "shell",
      "command": "cmake",
      "args": [
          "--build", "build",
          "--target", "clean"
      ]
    },
    {
      "label": "Env Debug",
      "type": "shell",
      "command": "env | grep -iE 'LD_LIBRARY_PATH|LIBGL'",
      "options": {
        "env": {
          "LD_LIBRARY_PATH": "/run/opengl-driver/lib:/run/current-system/sw/share/nix-ld/lib",
          "LIBGL_DRIVERS_PATH": "/run/opengl-driver/lib/dri"
        }
      }
    }
  ]
}
